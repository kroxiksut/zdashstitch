{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zdashstitch.example/schemas/project-v1.schema.json",
  "title": "ZDashstitch portable project v1",
  "type": "object",
  "required": [
    "format",
    "project_id",
    "catalogs",
    "roles",
    "dashboards"
  ],
  "properties": {
    "format": {
      "const": "zdashstitch.project/v1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "catalogs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "id",
          "file"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{1,63}$"
          },
          "file": {
            "type": "string",
            "pattern": "^metrics/[a-z][a-z0-9_-]{1,63}\\.ya?ml$"
          }
        },
        "additionalProperties": false
      }
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "patternProperties": {
        "^[a-z][a-z0-9_-]{1,63}$": {
          "type": "object",
          "required": [
            "cardinality"
          ],
          "properties": {
            "cardinality": {
              "enum": [
                "one",
                "many"
              ]
            },
            "description": {
              "type": "string",
              "maxLength": 300
            },
            "slots": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{1,63}$"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "dashboards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "pages"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{1,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "const": "global"
          },
          "pages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "widgets"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{1,63}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "widgets": {
                  "type": "array",
                  "maxItems": 256,
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "required": [
                          "id",
                          "type",
                          "title",
                          "expansion",
                          "series",
                          "layout"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_-]{1,63}$"
                          },
                          "type": {
                            "const": "graph"
                          },
                          "title": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          "expansion": {
                            "const": "series_per_host"
                          },
                          "series": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 32,
                            "items": {
                              "type": "object",
                              "required": [
                                "metric",
                                "hosts"
                              ],
                              "properties": {
                                "metric": {
                                  "type": "object",
                                  "required": [
                                    "catalog",
                                    "metric"
                                  ],
                                  "properties": {
                                    "catalog": {
                                      "type": "string",
                                      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
                                    },
                                    "metric": {
                                      "type": "string",
                                      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
                                    }
                                  },
                                  "additionalProperties": false
                                },
                                "hosts": {
                                  "type": "object",
                                  "required": [
                                    "role",
                                    "selection"
                                  ],
                                  "properties": {
                                    "role": {
                                      "type": "string",
                                      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
                                    },
                                    "selection": {
                                      "enum": [
                                        "all",
                                        "one",
                                        "slot"
                                      ]
                                    },
                                    "slot_id": {
                                      "type": "string",
                                      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
                                    }
                                  },
                                  "allOf": [
                                    {
                                      "if": {
                                        "properties": {
                                          "selection": {
                                            "const": "slot"
                                          }
                                        },
                                        "required": [
                                          "selection"
                                        ]
                                      },
                                      "then": {
                                        "required": [
                                          "slot_id"
                                        ]
                                      },
                                      "else": {
                                        "not": {
                                          "required": [
                                            "slot_id"
                                          ]
                                        }
                                      }
                                    }
                                  ],
                                  "additionalProperties": false
                                },
                                "color": {
                                  "type": "string",
                                  "pattern": "^#[0-9a-fA-F]{6}$"
                                }
                              },
                              "additionalProperties": false
                            }
                          },
                          "layout": {
                            "oneOf": [
                              {
                                "type": "object",
                                "required": [
                                  "mode",
                                  "w",
                                  "h"
                                ],
                                "properties": {
                                  "mode": {
                                    "const": "auto"
                                  },
                                  "w": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 72
                                  },
                                  "h": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 64
                                  }
                                },
                                "additionalProperties": false
                              },
                              {
                                "type": "object",
                                "required": [
                                  "mode",
                                  "x",
                                  "y",
                                  "w",
                                  "h"
                                ],
                                "properties": {
                                  "mode": {
                                    "const": "fixed"
                                  },
                                  "x": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 71
                                  },
                                  "y": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 63
                                  },
                                  "w": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 72
                                  },
                                  "h": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 64
                                  }
                                },
                                "additionalProperties": false
                              }
                            ]
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "id",
                          "type",
                          "title",
                          "expansion",
                          "metric",
                          "hosts",
                          "layout"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_-]{1,63}$"
                          },
                          "type": {
                            "const": "item_value"
                          },
                          "title": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          "expansion": {
                            "enum": [
                              "single",
                              "widget_per_host"
                            ]
                          },
                          "metric": {
                            "type": "object",
                            "required": [
                              "catalog",
                              "metric"
                            ],
                            "properties": {
                              "catalog": {
                                "type": "string",
                                "pattern": "^[a-z][a-z0-9_-]{1,63}$"
                              },
                              "metric": {
                                "type": "string",
                                "pattern": "^[a-z][a-z0-9_-]{1,63}$"
                              }
                            },
                            "additionalProperties": false
                          },
                          "hosts": {
                            "type": "object",
                            "required": [
                              "role",
                              "selection"
                            ],
                            "properties": {
                              "role": {
                                "type": "string",
                                "pattern": "^[a-z][a-z0-9_-]{1,63}$"
                              },
                              "selection": {
                                "enum": [
                                  "all",
                                  "one",
                                  "slot"
                                ]
                              },
                              "slot_id": {
                                "type": "string",
                                "pattern": "^[a-z][a-z0-9_-]{1,63}$"
                              }
                            },
                            "allOf": [
                              {
                                "if": {
                                  "properties": {
                                    "selection": {
                                      "const": "slot"
                                    }
                                  },
                                  "required": [
                                    "selection"
                                  ]
                                },
                                "then": {
                                  "required": [
                                    "slot_id"
                                  ]
                                },
                                "else": {
                                  "not": {
                                    "required": [
                                      "slot_id"
                                    ]
                                  }
                                }
                              }
                            ],
                            "additionalProperties": false
                          },
                          "layout": {
                            "oneOf": [
                              {
                                "type": "object",
                                "required": [
                                  "mode",
                                  "w",
                                  "h"
                                ],
                                "properties": {
                                  "mode": {
                                    "const": "auto"
                                  },
                                  "w": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 72
                                  },
                                  "h": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 64
                                  }
                                },
                                "additionalProperties": false
                              },
                              {
                                "type": "object",
                                "required": [
                                  "mode",
                                  "x",
                                  "y",
                                  "w",
                                  "h"
                                ],
                                "properties": {
                                  "mode": {
                                    "const": "fixed"
                                  },
                                  "x": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 71
                                  },
                                  "y": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 63
                                  },
                                  "w": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 72
                                  },
                                  "h": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 64
                                  }
                                },
                                "additionalProperties": false
                              }
                            ]
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
