{
  "name": "zdashstitch-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/check-dist.mjs normal dist",
    "build:demo": "vite build --mode demo --outDir dist-demo && node scripts/check-dist.mjs demo dist-demo",
    "check": "python ../tools/build_i18n.py --check && python ../tools/check_ui_contracts.py && svelte-check --tsconfig ./tsconfig.json",
    "dev": "vite",
    "test": "vitest run"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
